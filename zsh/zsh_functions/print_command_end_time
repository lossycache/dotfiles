function print_command_end_time() {
  local command_status=$?

  if (( ${+_SHELL_COMMAND_TIMESTAMPS_ACTIVE} )); then
    unset _SHELL_COMMAND_TIMESTAMPS_ACTIVE

    local command_ended_at
    command_ended_at=$(command date "+%Y-%m-%d %H:%M:%S %Z")
    print -P "%K{blue}%F{white}%B command ended:   ${command_ended_at} %b%f%k"
  fi

  return $command_status
}
